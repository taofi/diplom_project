# Database
DB_USER=admin
DB_PASSWORD=your-secure-password-here
DB_NAME=database
# Optional for docker-compose.yml:
# - leave empty to use external volume "project_db_data" (recommended)
# - set to host path for bind mount fallback, e.g. ./.docker-data/postgres
#   actual example: DB_DATA_PATH=./.docker-data/postgres
# DB_DATA_PATH=

# JWT Secrets (генерируйте надежные ключи для production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
MAIL_USER=nadzin031@gmail.com
MAIL_PASS=your-app-password-here
MAIL_FROM="No Reply" <nadzin031@gmail.com>

# Frontend URLs
NEXT_PUBLIC_API_URL=http://server:3000
NEXT_PUBLIC_SOCKET_URL=http://server:3000
FRONTEND_URL=http://localhost:4000

# Quick verification (dev):
# 1) docker volume create project_db_data
# 2) docker compose up -d db
# 3) write test row, then run: docker compose down -v
# 4) docker compose up -d db and verify data is still present