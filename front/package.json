{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --webpack -p 4000",
    "dev:turbo": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev -p 4000",
    "dev:clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && npm run dev",
    "start": "next start -p 4000",
    "build": "next build",
    "lint": "eslint"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.6",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "swiper": "^12.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-avatar-editor": "^13.0.4",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
